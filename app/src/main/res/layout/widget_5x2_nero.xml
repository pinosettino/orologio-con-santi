<?xml version="1.0" encoding="utf-8"?>
<!-- (testo nero) Widget 5x2: ora e secondi, data con frecce, santo, riga di appunto -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="4dp"
    android:paddingRight="10dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/clock_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:shadowColor="#99FFFFFF"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#000000"
                android:textSize="54sp" />

            <TextClock
                android:id="@+id/clock_sec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour=":ss"
                android:format24Hour=":ss"
                android:includeFontPadding="false"
                android:shadowColor="#99FFFFFF"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#000000"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/date_prev"
                android:layout_width="28dp"
                android:layout_height="36dp"
                android:contentDescription="Giorno precedente"
                android:scaleType="centerInside"
                android:src="@drawable/ic_prev_nero" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:shadowColor="#99FFFFFF"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:textColor="#000000"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/date_next"
                android:layout_width="28dp"
                android:layout_height="36dp"
                android:contentDescription="Giorno successivo"
                android:scaleType="centerInside"
                android:src="@drawable/ic_next_nero" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/saint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:shadowColor="#99FFFFFF"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:singleLine="true"
        android:textColor="#000000"
        android:textSize="17sp" />

    <LinearLayout
        android:id="@+id/note_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="34dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:shadowColor="#99FFFFFF"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:singleLine="true"
            android:textColor="#000000"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/note_prev"
            android:layout_width="28dp"
            android:layout_height="34dp"
            android:contentDescription="Parte precedente dell'appunto"
            android:scaleType="centerInside"
            android:src="@drawable/ic_prev_nero"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/note_next"
            android:layout_width="28dp"
            android:layout_height="34dp"
            android:contentDescription="Parte successiva dell'appunto"
            android:scaleType="centerInside"
            android:src="@drawable/ic_next_nero"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
