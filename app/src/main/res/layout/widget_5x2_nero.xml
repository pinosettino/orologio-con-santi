<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 5x2 (testo nero): orologio a sinistra, data a destra (con la sveglia sotto), santo, appunto che scorre -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="4dp"
    android:paddingRight="10dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#99FFFFFF"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#000000"
            android:textSize="54sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <!-- zona invisibile a sinistra della data: giorno precedente -->
                <ImageView
                    android:id="@+id/zone_prev"
                    android:layout_width="28dp"
                    android:layout_height="38dp"
                    android:contentDescription="Giorno precedente" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:shadowColor="#99FFFFFF"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:textColor="#000000"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- zona invisibile a destra della data: giorno successivo -->
                <ImageView
                    android:id="@+id/zone_next"
                    android:layout_width="22dp"
                    android:layout_height="38dp"
                    android:contentDescription="Giorno successivo" />
            </LinearLayout>

            <!-- prossima sveglia: piccola, sotto la data, allineata a destra con la data -->
            <LinearLayout
                android:id="@+id/alarm_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:paddingRight="22dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/alarm_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="3dp"
                    android:contentDescription="Prossima sveglia"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_alarm_nero" />

                <TextView
                    android:id="@+id/alarm_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:shadowColor="#99FFFFFF"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:textColor="#000000"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/saint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:shadowColor="#99FFFFFF"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:singleLine="true"
        android:textColor="#000000"
        android:textSize="17sp" />

    <!-- riga dell'appunto: i pezzi vengono aggiunti dal codice e girano da soli ogni 3 secondi -->
    <FrameLayout
        android:id="@+id/note_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp">

        <ViewFlipper
            android:id="@+id/note_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:autoStart="true"
            android:flipInterval="3000"
            android:inAnimation="@anim/note_in"
            android:outAnimation="@anim/note_out" />
    </FrameLayout>
</LinearLayout>
